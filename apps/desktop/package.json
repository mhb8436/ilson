{
  "name": "@ilson/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "일손 - 크래프틱 업무비서 (Windows 데스크톱)",
  "author": "Craftic",
  "license": "UNLICENSED",
  "main": "dist/main.cjs",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "pnpm build:main && pnpm build:renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "pnpm build && electron .",
    "dist:win": "pnpm build && electron-builder --win --x64 --publish never",
    "e2e": "node e2e/smoke.mjs"
  },
  "devDependencies": {
    "@ilson/collate": "workspace:*",
    "@ilson/service": "workspace:*",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
